rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function deletionRequest(uid) {
      return /databases/$(database)/documents/accountDeletionRequests/$(uid);
    }

    function activeAccount(uid) {
      return !exists(deletionRequest(uid));
    }

    function recentSignIn() {
      return request.auth.token.auth_time is int
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function validEmailDomain(domain) {
      return domain is string && domain.size() <= 253
        && domain.matches('^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$');
    }

    function emailAtDomain(email, domain) {
      return email is string && email.size() <= 254
        && email.matches('^[^\\s@<>]+@[a-zA-Z0-9.-]+$')
        && email.split('@')[1].lower() == domain;
    }

    function canJoinSchool(schoolId) {
      return verifiedEmail()
        && ! (schoolId in ['alderline', 'cedarbrook'])
        && schoolId.matches('^[a-z0-9][a-z0-9-]{0,79}$')
        && matchesApprovedSchool(schoolId);
    }

    function matchesApprovedSchool(schoolId) {
      let school = get(/databases/$(database)/documents/schoolRegistry/$(schoolId)).data;
      return school.status == 'approved'
        && validEmailDomain(school.emailDomain)
        && emailAtDomain(request.auth.token.email, school.emailDomain);
    }

    function schoolApplicationOk(data) {
      return data.keys().hasOnly([
          'schoolName', 'applicantName', 'applicantRole', 'applicantEmail',
          'contactEmail', 'emailDomain', 'location', 'color',
          'status', 'submittedAt'
        ])
        && data.applicantEmail == request.auth.token.email
        && data.schoolName is string && data.schoolName.trim().size() >= 2
        && data.schoolName.size() <= 120
        && data.applicantName is string && data.applicantName.trim().size() >= 2
        && data.applicantName.size() <= 80
        && data.applicantRole is string && data.applicantRole.trim().size() >= 2
        && data.applicantRole.size() <= 80
        && data.location is string && data.location.size() <= 120
        && validEmailDomain(data.emailDomain)
        && emailAtDomain(data.contactEmail, data.emailDomain)
        && data.color is string && data.color.matches('^#[A-Fa-f0-9]{6}$')
        && data.status == 'pending'
        && data.submittedAt == request.time;
    }

    function schoolProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userData() {
      return schoolProfile(request.auth.uid);
    }

    function belongsToSchool(schoolId) {
      return signedIn() && userData().schoolId == schoolId;
    }

    function noSecrets(data) {
      return !data.keys().hasAny([
        'password',
        'passwordHash',
        'salt',
        'calendar',
        'calendarUrl',
        'calendarImport',
        'webcal',
        'icsUrl'
      ]);
    }

    function communityTextOk(text, maxLength) {
      return text is string && text.size() <= maxLength
        && !text.lower().matches('[\\s\\S]*\\b(kill\\s+yourself|i\\s+will\\s+kill\\s+you|fuck\\s+you)\\b[\\s\\S]*');
    }

    function moderationUidOk(uid) {
      return uid is string && uid.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function moderationDocumentIdOk(id) {
      return id is string && id.matches('^[A-Za-z0-9_:-]{1,257}$');
    }

    function canContact(schoolId, first, second) {
      return activeAccount(first) && activeAccount(second)
        && !existsAfter(/databases/$(database)/documents/users/$(first)/schools/$(schoolId)/blocked/$(second))
        && !existsAfter(/databases/$(database)/documents/users/$(second)/schools/$(schoolId)/blocked/$(first));
    }

    function authorNameOk(data) {
      return !('authorName' in data)
        || (data.authorName is string && data.authorName == userData().name);
    }

    function postAuthorNameOk(data) {
      return authorNameOk(data)
        && (!('authorName' in data) || data.get('anonymous', false) == false);
    }

    function profileOk() {
      return noSecrets(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'email',
          'name',
          'grade',
          'schoolId',
          'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.grade is int
        && request.resource.data.grade >= 9
        && request.resource.data.grade <= 12;
    }

    // Only the approved public catalog is available before sign-in.
    match /schoolRegistry/{schoolId} {
      allow get: if resource.data.status == 'approved'
        || (resource.data.status == 'review' && belongsToSchool(schoolId));
      allow list: if resource.data.status == 'approved';
      allow create, update, delete: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && recentSignIn()
        && request.resource.data.keys().hasOnly(['status', 'requestedAt', 'receipt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.receipt is string
        && request.resource.data.receipt.matches('^[0-9a-f]{48}$')
        && getAfter(/databases/$(database)/documents/accountDeletionReceipts/$(request.resource.data.receipt)).data.status == 'pending'
        && !exists(/databases/$(database)/documents/accountDeletionReceipts/$(request.resource.data.receipt));
      allow list, update, delete: if false;
    }

    // The randomized receipt carries only the status, including once Auth is deleted.
    match /accountDeletionReceipts/{receipt} {
      allow get: if true;
      allow create: if signedIn()
        && activeAccount(request.auth.uid)
        && getAfter(deletionRequest(request.auth.uid)).data.receipt == receipt
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status == 'pending';
      allow list, update, delete: if false;
    }

    match /schoolApplications/{applicantId} {
      allow get: if signedIn() && request.auth.uid == applicantId;
      allow create: if verifiedEmail()
        && request.auth.uid == applicantId
        && activeAccount(request.auth.uid)
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
            || (request.auth.token.firebase.sign_in_provider == 'password'
                && request.auth.token.email.lower() == request.resource.data.contactEmail.lower()))
        && schoolApplicationOk(request.resource.data);
      allow update, delete, list: if false;
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      function noNewPostPhotos(data) {
        return data.get('photos', []) == [];
      }

      match /photoSubmissions/{postId} {
        function galleryPhotoOk(photo) {
          return photo is string && photo.size() >= 32 && photo.size() <= 160000
            && photo.size() % 4 == 0
            && photo.matches('^iVBORw0KGgo[A-Za-z0-9+/]+={0,2}$');
        }

        function galleryPhotosOk(photos) {
          return photos is list && photos.size() >= 1 && photos.size() <= 4
            && galleryPhotoOk(photos[0])
            && (photos.size() < 2 || galleryPhotoOk(photos[1]))
            && (photos.size() < 3 || galleryPhotoOk(photos[2]))
            && (photos.size() < 4 || galleryPhotoOk(photos[3]));
        }

        function newPhotoSubmissionOk(data) {
          return data.keys().hasOnly([
              'id', 'authorId', 'authorName', 'title', 'body', 'category',
              'subtag', 'at', 'anonymous', 'priority', 'askedPerson', 'photos',
              'likes', 'status', 'submittedAt'
            ])
            && moderationDocumentIdOk(postId)
            && data.id == postId
            && data.authorId == request.auth.uid
            && data.category == 'gallery'
            && data.subtag in ['Campus', 'Sports', 'Arts']
            && data.at is string && data.at.size() <= 35
            && data.anonymous is bool
            && (data.anonymous || 'authorName' in data)
            && postAuthorNameOk(data)
            && data.priority == 'Normal'
            && data.askedPerson == null
            && data.likes == 0
            && communityTextOk(data.title, 140)
            && communityTextOk(data.body, 5000)
            && galleryPhotosOk(data.photos)
            && data.status == 'pending'
            && data.submittedAt == request.time;
        }

        // A submitter can retry the same ID if their acknowledgement was lost.
        allow get: if belongsToSchool(schoolId)
          && (resource == null || resource.data.authorId == request.auth.uid);
        allow list: if belongsToSchool(schoolId)
          && resource.data.authorId == request.auth.uid
          && request.query.limit <= 10;
        allow create: if belongsToSchool(schoolId)
          && activeAccount(request.auth.uid)
          && newPhotoSubmissionOk(request.resource.data)
          && !exists(/databases/$(database)/documents/schools/$(schoolId)/posts/$(postId));
        allow update, delete: if false;
      }

      match /posts/{postId} {
        allow read: if belongsToSchool(schoolId);
        allow create: if belongsToSchool(schoolId)
          && request.resource.data.authorId == request.auth.uid
          && noSecrets(request.resource.data)
          && activeAccount(request.auth.uid)
          && communityTextOk(request.resource.data.title, 140)
          && communityTextOk(request.resource.data.body, 5000)
          && noNewPostPhotos(request.resource.data)
          && postAuthorNameOk(request.resource.data);
        allow update: if belongsToSchool(schoolId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && noSecrets(request.resource.data)
          && activeAccount(request.auth.uid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'body'])
            || (communityTextOk(request.resource.data.title, 140)
              && communityTextOk(request.resource.data.body, 5000)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos'])
            || noNewPostPhotos(request.resource.data))
          && postAuthorNameOk(request.resource.data);
        allow delete: if belongsToSchool(schoolId)
          && resource.data.authorId == request.auth.uid;

        match /replies/{replyId} {
          function parentPost() {
            return /databases/$(database)/documents/schools/$(schoolId)/posts/$(postId);
          }

          allow read: if belongsToSchool(schoolId) && exists(parentPost());
          allow create: if belongsToSchool(schoolId)
            && exists(parentPost())
            && request.resource.data.authorId == request.auth.uid
            && noSecrets(request.resource.data)
            && activeAccount(request.auth.uid)
            && communityTextOk(request.resource.data.body, 2000)
            && authorNameOk(request.resource.data);
          allow update: if belongsToSchool(schoolId)
            && exists(parentPost())
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && noSecrets(request.resource.data)
            && activeAccount(request.auth.uid)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['body'])
              || communityTextOk(request.resource.data.body, 2000))
            && authorNameOk(request.resource.data);
          allow delete: if belongsToSchool(schoolId)
            && (resource.data.authorId == request.auth.uid
              || get(parentPost()).data.authorId == request.auth.uid);
        }
      }

      match /moderationReports/{reportId} {
        function submittedReportOk(data) {
          return data.keys().hasOnly([
              'kind', 'parentId', 'contentId', 'reason', 'reporterId',
              'targetUid', 'title', 'body', 'createdAt', 'status'
            ])
            && data.kind in ['post', 'comment', 'message']
            && data.reason in ['harassment', 'unsafe', 'privacy', 'inappropriate', 'spam', 'other']
            && data.reporterId == request.auth.uid
            && moderationUidOk(data.targetUid)
            && data.targetUid != request.auth.uid
            && activeAccount(data.targetUid)
            && data.title is string && data.title.size() <= 140
            && data.body is string && data.body.size() <= 5000
            && moderationDocumentIdOk(data.contentId)
            && data.createdAt == request.time
            && data.status == 'pending';
        }

        function reportsPost(data) {
          let post = get(/databases/$(database)/documents/schools/$(schoolId)/posts/$(data.contentId)).data;
          return data.parentId == ''
            && data.targetUid == post.authorId
            && data.title == post.title
            && data.body == post.body;
        }

        function reportsComment(data) {
          let postPath = /databases/$(database)/documents/schools/$(schoolId)/posts/$(data.parentId);
          let reply = get(/databases/$(database)/documents/schools/$(schoolId)/posts/$(data.parentId)/replies/$(data.contentId)).data;
          return exists(postPath)
            && data.targetUid == reply.authorId
            && data.title == ''
            && data.body == reply.body;
        }

        function reportsMessage(data) {
          let friendship = get(/databases/$(database)/documents/schools/$(schoolId)/friendRequests/$(data.parentId)).data;
          let message = get(/databases/$(database)/documents/schools/$(schoolId)/friendRequests/$(data.parentId)/messages/$(data.contentId)).data;
          return friendship.status == 'accepted'
            && request.auth.uid in friendship.participants
            && data.targetUid in friendship.participants
            && data.targetUid == message.senderId
            && data.title == ''
            && data.body == message.text;
        }

        // Only authorized administrators can read and resolve reports.
        allow read, update, delete: if false;
        allow create: if belongsToSchool(schoolId)
          && activeAccount(request.auth.uid)
          && submittedReportOk(request.resource.data)
          && ((request.resource.data.kind == 'post' && reportsPost(request.resource.data))
            || (moderationDocumentIdOk(request.resource.data.parentId)
              && ((request.resource.data.kind == 'comment' && reportsComment(request.resource.data))
                || (request.resource.data.kind == 'message' && reportsMessage(request.resource.data)))));
      }

      match /directory/{uid} {
        allow read: if belongsToSchool(schoolId);
        allow create, update: if belongsToSchool(schoolId)
          && request.auth.uid == uid
          && activeAccount(uid)
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name == userData().name;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /friendRequests/{pairId} {
        function matchesSortedPair(data) {
          let senderFirst = data.senderId < data.recipientId;
          let first = senderFirst ? data.senderId : data.recipientId;
          let second = senderFirst ? data.recipientId : data.senderId;
          return first != second
            && pairId == first + ':' + second
            && data.participants == [first, second];
        }

        function sendsPendingRequest() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'participants', 'senderId', 'recipientId', 'senderName',
              'status', 'createdAt', 'updatedAt'
            ])
            && moderationUidOk(data.senderId)
            && moderationUidOk(data.recipientId)
            && data.senderId == request.auth.uid
            && matchesSortedPair(data)
            && canContact(schoolId, data.senderId, data.recipientId)
            && data.senderName is string
            && data.senderName == userData().name
            && data.status == 'pending'
            && data.createdAt == request.time
            && data.updatedAt == request.time
            && schoolProfile(data.recipientId).schoolId == schoolId;
        }

        function respondsToPendingRequest() {
          let data = request.resource.data;
          let changes = data.diff(resource.data).affectedKeys();
          return resource.data.status == 'pending'
            && data.updatedAt == request.time
            && (
              (data.status == 'canceled'
                && request.auth.uid == resource.data.senderId
                && changes.hasOnly(['status', 'updatedAt']))
              || (data.status == 'declined'
                && request.auth.uid == resource.data.recipientId
                && changes.hasOnly(['status', 'updatedAt']))
              || (data.status == 'accepted'
                && request.auth.uid == resource.data.recipientId
                && canContact(schoolId, resource.data.senderId, resource.data.recipientId)
                && changes.hasOnly(['status', 'updatedAt', 'recipientName'])
                && data.recipientName is string
                && data.recipientName == userData().name
                && schoolProfile(resource.data.senderId).schoolId == schoolId)
            );
        }

        // A transaction must be able to read its own pair before it exists.
        allow get: if belongsToSchool(schoolId)
          && request.auth.uid in pairId.split(':');
        allow list: if belongsToSchool(schoolId)
          && request.auth.uid in resource.data.participants;
        allow create: if belongsToSchool(schoolId) && sendsPendingRequest();
        allow update: if belongsToSchool(schoolId)
          && ((resource.data.status == 'canceled' && sendsPendingRequest())
            || respondsToPendingRequest());
        allow delete: if false;

        match /messages/{messageId} {
          function acceptedConversation() {
            let friendship = get(
              /databases/$(database)/documents/schools/$(schoolId)/friendRequests/$(pairId)
            ).data;
            let otherUid = friendship.senderId == request.auth.uid
              ? friendship.recipientId : friendship.senderId;
            return friendship.status == 'accepted'
              && request.auth.uid in friendship.participants
              && schoolProfile(otherUid).schoolId == schoolId;
          }

          function messageParticipant() {
            return belongsToSchool(schoolId)
              && request.auth.uid in pairId.split(':')
              && acceptedConversation();
          }

          function sendsMessage() {
            let data = request.resource.data;
            return messageId.matches('^[A-Za-z0-9_-]{1,128}:[A-Za-z0-9]{20}$')
              && messageId.split(':')[0] == request.auth.uid
              && data.keys().hasOnly(['senderId', 'text', 'createdAt'])
              && data.senderId == request.auth.uid
              && canContact(schoolId, pairId.split(':')[0], pairId.split(':')[1])
              && communityTextOk(data.text, 4000)
              && !data.text.matches('^\\s*$')
              && data.createdAt == request.time;
          }

          allow get: if messageParticipant();
          allow list: if messageParticipant() && request.query.limit <= 50;
          allow create: if messageParticipant() && sendsMessage();
          allow update, delete: if false;
        }
      }

      // Older clients used shared demo IDs that do not identify participants.
      match /threads/{legacyPath=**} {
        allow read, write: if false;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && activeAccount(uid)
        && profileOk()
        && canJoinSchool(request.resource.data.schoolId);
      allow update: if signedIn()
        && request.auth.uid == uid
        && activeAccount(uid)
        && profileOk()
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;

      match /schools/{schoolId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && activeAccount(uid)
          && noSecrets(request.resource.data);
        allow delete: if false;

        match /blocked/{peerUid} {
          function ownsBlockList() {
            return belongsToSchool(schoolId) && request.auth.uid == uid && activeAccount(uid);
          }

          function blockOk(data) {
            return data.keys().hasOnly(['targetUid', 'displayName', 'createdAt'])
              && data.targetUid == peerUid
              && data.displayName is string
              && data.displayName.trim().size() >= 1
              && data.displayName.size() <= 120
              && data.createdAt == request.time;
          }

          allow read: if ownsBlockList();
          allow create, update: if ownsBlockList()
            && activeAccount(uid)
            && moderationUidOk(peerUid)
            && peerUid != uid
            && schoolProfile(peerUid).schoolId == schoolId
            && activeAccount(peerUid)
            && blockOk(request.resource.data);
          allow delete: if ownsBlockList() && activeAccount(uid);
        }

        match /threads/{threadId} {
          function ownsChat() {
            return belongsToSchool(schoolId) && request.auth.uid == uid && activeAccount(uid);
          }

          allow read: if ownsChat();
          allow create, update: if ownsChat()
            && noSecrets(request.resource.data);
          allow delete: if false;

          match /messages/{messageId} {
            allow read: if ownsChat();
            allow create: if ownsChat()
              && request.resource.data.senderId == uid
              && noSecrets(request.resource.data);
            allow update: if ownsChat()
              && resource.data.senderId == uid
              && request.resource.data.senderId == uid
              && noSecrets(request.resource.data);
            allow delete: if ownsChat() && resource.data.senderId == uid;
          }
        }
      }
    }
  }
}
