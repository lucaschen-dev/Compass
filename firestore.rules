rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function schoolProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userData() {
      return schoolProfile(request.auth.uid);
    }

    function belongsToSchool(schoolId) {
      return signedIn() && userData().schoolId == schoolId;
    }

    function noSecrets(data) {
      return !data.keys().hasAny([
        'password',
        'passwordHash',
        'salt',
        'calendar',
        'calendarUrl',
        'calendarImport',
        'webcal',
        'icsUrl'
      ]);
    }

    function profileOk() {
      return noSecrets(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'email',
          'name',
          'grade',
          'schoolId',
          'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolId in ['alderline', 'cedarbrook']
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
          || request.resource.data.email.matches(
            '^[^@]+@' + request.resource.data.schoolId + '\\.example$'
          ))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.grade is int
        && request.resource.data.grade >= 9
        && request.resource.data.grade <= 12;
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /posts/{postId} {
        allow read: if belongsToSchool(schoolId);
        allow create: if belongsToSchool(schoolId)
          && request.resource.data.authorId == request.auth.uid
          && noSecrets(request.resource.data);
        allow update: if belongsToSchool(schoolId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && noSecrets(request.resource.data);
        allow delete: if belongsToSchool(schoolId)
          && resource.data.authorId == request.auth.uid;

        match /replies/{replyId} {
          function parentPost() {
            return /databases/$(database)/documents/schools/$(schoolId)/posts/$(postId);
          }

          allow read: if belongsToSchool(schoolId) && exists(parentPost());
          allow create: if belongsToSchool(schoolId)
            && exists(parentPost())
            && request.resource.data.authorId == request.auth.uid
            && noSecrets(request.resource.data);
          allow update: if belongsToSchool(schoolId)
            && exists(parentPost())
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && noSecrets(request.resource.data);
          allow delete: if belongsToSchool(schoolId)
            && (resource.data.authorId == request.auth.uid
              || get(parentPost()).data.authorId == request.auth.uid);
        }
      }

      match /directory/{uid} {
        allow read: if belongsToSchool(schoolId);
        allow create, update: if belongsToSchool(schoolId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name == userData().name;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /friendRequests/{pairId} {
        function validUid(uid) {
          return uid is string && uid.matches('^[A-Za-z0-9_-]{1,128}$');
        }

        function matchesSortedPair(data) {
          let senderFirst = data.senderId < data.recipientId;
          let first = senderFirst ? data.senderId : data.recipientId;
          let second = senderFirst ? data.recipientId : data.senderId;
          return first != second
            && pairId == first + ':' + second
            && data.participants == [first, second];
        }

        function sendsPendingRequest() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'participants', 'senderId', 'recipientId', 'senderName',
              'status', 'createdAt', 'updatedAt'
            ])
            && validUid(data.senderId)
            && validUid(data.recipientId)
            && data.senderId == request.auth.uid
            && matchesSortedPair(data)
            && data.senderName is string
            && data.senderName == userData().name
            && data.status == 'pending'
            && data.createdAt == request.time
            && data.updatedAt == request.time
            && schoolProfile(data.recipientId).schoolId == schoolId;
        }

        function respondsToPendingRequest() {
          let data = request.resource.data;
          let changes = data.diff(resource.data).affectedKeys();
          return resource.data.status == 'pending'
            && data.updatedAt == request.time
            && (
              (data.status == 'canceled'
                && request.auth.uid == resource.data.senderId
                && changes.hasOnly(['status', 'updatedAt']))
              || (data.status == 'declined'
                && request.auth.uid == resource.data.recipientId
                && changes.hasOnly(['status', 'updatedAt']))
              || (data.status == 'accepted'
                && request.auth.uid == resource.data.recipientId
                && changes.hasOnly(['status', 'updatedAt', 'recipientName'])
                && data.recipientName is string
                && data.recipientName == userData().name
                && schoolProfile(resource.data.senderId).schoolId == schoolId)
            );
        }

        // A transaction must be able to read its own pair before it exists.
        allow get: if belongsToSchool(schoolId)
          && request.auth.uid in pairId.split(':');
        allow list: if belongsToSchool(schoolId)
          && request.auth.uid in resource.data.participants;
        allow create: if belongsToSchool(schoolId) && sendsPendingRequest();
        allow update: if belongsToSchool(schoolId)
          && ((resource.data.status == 'canceled' && sendsPendingRequest())
            || respondsToPendingRequest());
        allow delete: if false;

        match /messages/{messageId} {
          function acceptedConversation() {
            let friendship = get(
              /databases/$(database)/documents/schools/$(schoolId)/friendRequests/$(pairId)
            ).data;
            let otherUid = friendship.senderId == request.auth.uid
              ? friendship.recipientId : friendship.senderId;
            return friendship.status == 'accepted'
              && request.auth.uid in friendship.participants
              && schoolProfile(otherUid).schoolId == schoolId;
          }

          function messageParticipant() {
            return belongsToSchool(schoolId)
              && request.auth.uid in pairId.split(':')
              && acceptedConversation();
          }

          function sendsMessage() {
            let data = request.resource.data;
            return messageId.matches('^[A-Za-z0-9_-]{1,128}:[A-Za-z0-9]{20}$')
              && messageId.split(':')[0] == request.auth.uid
              && data.keys().hasOnly(['senderId', 'text', 'createdAt'])
              && data.senderId == request.auth.uid
              && data.text is string
              && data.text.size() <= 4000
              && !data.text.matches('^\\s*$')
              && data.createdAt == request.time;
          }

          allow get: if messageParticipant();
          allow list: if messageParticipant() && request.query.limit <= 50;
          allow create: if messageParticipant() && sendsMessage();
          allow update, delete: if false;
        }
      }

      // Older clients used shared demo IDs that do not identify participants.
      match /threads/{legacyPath=**} {
        allow read, write: if false;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && profileOk();
      allow update: if signedIn()
        && request.auth.uid == uid
        && profileOk()
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;

      match /schools/{schoolId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && noSecrets(request.resource.data);
        allow delete: if false;

        match /threads/{threadId} {
          function ownsChat() {
            return belongsToSchool(schoolId) && request.auth.uid == uid;
          }

          allow read: if ownsChat();
          allow create, update: if ownsChat()
            && noSecrets(request.resource.data);
          allow delete: if false;

          match /messages/{messageId} {
            allow read: if ownsChat();
            allow create: if ownsChat()
              && request.resource.data.senderId == uid
              && noSecrets(request.resource.data);
            allow update: if ownsChat()
              && resource.data.senderId == uid
              && request.resource.data.senderId == uid
              && noSecrets(request.resource.data);
            allow delete: if ownsChat() && resource.data.senderId == uid;
          }
        }
      }
    }
  }
}
